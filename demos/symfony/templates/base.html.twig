<!DOCTYPE html>
<html lang="en"{% if nativella_is_native() %} data-native="1"{% endif %}{% if nativella_is_mobile() %} data-mobile="1"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="color-scheme" content="light dark">
        <title>{% block title %}Notes{% endblock %}</title>
        <link rel="icon" href="{{ asset('icon.svg') }}">
        <link rel="stylesheet" href="{{ asset('app.css') }}">
        <script src="{{ asset('app.js') }}" defer></script>
    </head>
    <body>
        <aside class="sidebar">
            <form class="search" action="{{ path('note_search') }}" method="get" role="search">
                <input type="search" name="q" value="{{ q ?? '' }}" placeholder="Search notes" aria-label="Search notes">
            </form>
            <nav aria-label="Notes">
                {% for item in notes %}
                    <a href="{{ path('note_show', {id: item.id}) }}"
                       class="note-link{% if note is defined and note and note.id == item.id %} active{% endif %}"
                       data-context-menu="{{ path('note_context_menu', {id: item.id}) }}">
                        <span class="note-title">{% if item.pinned %}<span class="pin" title="Pinned">●</span> {% endif %}{{ item.title }}</span>
                        <span class="note-date">{{ item.updatedAt|date('M j, H:i') }}</span>
                    </a>
                {% else %}
                    <p class="muted empty-list">No note.</p>
                {% endfor %}
            </nav>
            <footer class="sidebar-actions">
                <a class="button primary" href="{{ path('note_new') }}">New note</a>
                {% if nativella_is_native() %}
                    <form action="{{ path('note_import') }}" method="post"><button>Import…</button></form>
                {% endif %}
                <a class="button ghost" href="{{ path('settings') }}" title="Settings" aria-label="Settings">⚙</a>
            </footer>
        </aside>

        <main>
            {% for message in app.flashes('success') %}
                <p class="flash" role="status">{{ message }}</p>
            {% endfor %}
            {% if not nativella_is_native() %}
                <p class="flash warning">Running in a browser: native features (dialogs, clipboard, export…) need Nativella.</p>
            {% endif %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
