{% extends 'base.html.twig' %}

{% block body %}
    <section class="empty">
        <h1>No notes yet</h1>
        {% if nativella_is_mobile() %}
            <p>Write your first note, or import Markdown files.</p>
        {% else %}
            <p>Write your first note, import Markdown files{% if nativella_is_native() %}, or drop them on this window{% endif %}.</p>
            <p class="shortcuts">
                <kbd>Ctrl</kbd> <kbd>N</kbd> new note ·
                <kbd>Ctrl</kbd> <kbd>Shift</kbd> <kbd>N</kbd> quick note, from anywhere
            </p>
        {% endif %}
        <a class="button primary" href="{{ path('note_new') }}">New note</a>
    </section>
{% endblock %}
