{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nativella/demo-laravel",
    "type": "project",
    "description": "Nativella Tasks: a Laravel application running as a desktop application.",
    "keywords": [
        "desktop",
        "laravel",
        "nativella"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "nativella/laravel": "^0.3@dev",
        "nativella/nativella": "^0.3@dev"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "versions": {
                    "nativella/laravel": "0.3.x-dev",
                    "nativella/nativella": "0.3.x-dev",
                    "nativella/symfony-bundle": "0.3.x-dev"
                }
            }
        }
    ],
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "nativella": {
            "name": "Nativella Tasks",
            "identifier": "dev.nativella.demo.laravel",
            "window": {
                "title": "Tasks",
                "width": 900,
                "height": 700
            },
            "permissions": ["haptics"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
