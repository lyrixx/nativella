#!/usr/bin/env php
<?php

/*
 * Builds the landing page into dist/, and stages the documents of docs/ in
 * var/docs/, from which Zensical builds the documentation into dist/docs/
 * afterwards: see zensical.yml.
 *
 *     bin/build
 *
 * NATIVELLA_SITE_URL is where the site is published, for the few URLs that
 * must be absolute (Open Graph, canonical). Every other link is relative.
 */

use Nativella\Website\Documentation;
use Nativella\Website\Site;

require dirname(__DIR__).'/vendor/autoload.php';

$started = hrtime(true);

$site = new Site(
    projectDir: dirname(__DIR__, 2),
    websiteDir: dirname(__DIR__),
    outputDir: dirname(__DIR__).'/dist',
    siteUrl: rtrim(getenv('NATIVELLA_SITE_URL') ?: 'https://lyrixx.github.io/nativella', '/').'/',
);
$site->build();

$documentation = new Documentation(
    projectDir: dirname(__DIR__, 2),
    outputDir: dirname(__DIR__).'/var/docs',
);
$documentation->stage();

printf("Built the landing page into website/dist/, and staged the documentation in website/var/docs/, in %d ms.\n", (hrtime(true) - $started) / 1_000_000);
