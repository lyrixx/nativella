{% extends 'layout.html.twig' %}

{% set title = 'Nativella: your PHP app, in a window of its own' %}
{% set description = 'Nativella runs a Symfony, Laravel or plain PHP application as a desktop application, in a native window, with PHP inside the application process. It needs no web server and opens no port.' %}
{% set body_class = 'page-home' %}

{% block content %}
{% set apis = [
    {slug: 'windows', name: 'Windows', description: 'Open, move, resize and hide windows, each known by its label. Print one to PDF.', example: "$window->open('settings')"},
    {slug: 'menus', name: 'Menus', description: 'The application menu and context menus. Clicks come back as events.', example: '$menu->popup(...$items)'},
    {slug: 'tray', name: 'Tray', description: 'An icon in the system tray, with a menu. The app lives on without windows.', example: "$tray->set('Notes')"},
    {slug: 'dialogs', name: 'Dialogs', description: 'Messages, questions, file pickers. The answer is a return value.', example: "$dialog->confirm('Sure?')"},
    {slug: 'notifications', name: 'Notifications', description: 'Desktop notifications, from any request. A click comes back as an event.', example: "$notification->send('Hi')"},
    {slug: 'clipboard', name: 'Clipboard', description: 'Read and write text and images, and write HTML, from PHP.', example: '$clipboard->readText()'},
    {slug: 'global-shortcuts', name: 'Global shortcuts', description: 'Keyboard shortcuts that fire while the app is in the background.', example: 'GlobalShortcutPressed'},
    {slug: 'settings', name: 'Settings', description: 'A key-value store for preferences, kept as JSON in the data directory.', example: "$settings->get('theme')"},
    {slug: 'secrets', name: 'Secrets', description: 'Tokens and passwords in the keychain of the system, encrypted by it.', example: "$secrets->get('token')"},
    {slug: 'timers', name: 'Timers', description: 'Wake PHP up for periodic work: a sync, a cleanup, a reminder.', example: "$timer->every('sync', 300)"},
    {slug: 'child-processes', name: 'Child processes', description: 'Start a worker or a tool. Its output and its end come back as events.', example: 'ChildProcessOutput $event'},
    {slug: 'power', name: 'Power', description: 'Battery level, power source, an event when the computer wakes up, and keeping it awake.', example: '$power->isOnBattery()'},
    {slug: 'shell', name: 'Shell', description: 'Open URLs in the browser, files with their application, folders in the file manager.', example: '$shell->openUrl($url)'},
    {slug: 'screens', name: 'Screens', description: 'Displays, work areas, scale factors and the cursor.', example: '$screen->primary()'},
    {slug: 'system', name: 'System', description: 'The operating system, its locale, and the light or dark theme.', example: '$system->theme()'},
    {slug: 'javascript', name: 'Pages', description: 'Push events from PHP to the JavaScript of any window.', example: "$page->dispatch('saved')"},
    {slug: 'app', name: 'App', description: 'Identity, directories, autostart, badge count, quit and restart.', example: '$app->enableAutostart()'},
    {slug: 'lifecycle', name: 'Native events', description: 'Menu clicks, shortcuts, dropped files, focus and theme changes, as typed objects.', example: 'MenuItemClicked $event'},
    {slug: 'database', name: 'Database', description: 'SQLite in the data directory, migrated when the app starts.', example: 'NATIVELLA_DATA_DIR'},
    {slug: 'configuration', name: 'Deep links', description: 'notes://42 in a browser or a mail opens the app, and PHP gets the URL.', example: 'AppUrlsOpened $event'},
    {slug: 'building', name: 'Standalone build', description: 'One executable that carries your whole project and its PHP, a Debian package of it, and updates you sign.', example: 'nativella build notes'},
    {slug: 'mobile', name: 'Android and iOS', description: 'The same project in an APK or an iOS app, experimentally.', example: 'nativella android --template <apk>'},
    {slug: 'phone-apis', name: 'Phone APIs', description: 'Vibrations, the location of the phone, fingerprint and face authentication, barcodes, NFC tags, the share sheet.', example: "$biometrics->authenticate('Unlock')"},
] %}
<main id="content">
    <section class="hero">
        <div class="wrap hero-grid">
            <div class="hero-text">
                <a class="hero-eyebrow" href="#status"><span class="pulse" aria-hidden="true"></span> <span class="hero-eyebrow-wide">Open source · </span>v{{ site.version }} · desktop, Android and iOS (experimental)</a>
                <h1>Your PHP app, in a window of its&nbsp;own.</h1>
                <p class="hero-lede">Nativella runs Symfony, Laravel or plain PHP as a desktop application and, experimentally, on Android and iOS. Built on PHP, Rust and Tauri, it hands every request of the window to a PHP embedded in the same process, so no web server runs and no port opens.</p>
                <div class="hero-actions">
                    <a class="button button-primary" href="docs/getting-started/">Get started <span aria-hidden="true">→</span></a>
                    <a class="button button-secondary" href="#how-it-works">How it works</a>
                </div>
                <p class="hero-command"><code><span aria-hidden="true">$ </span>nativella run path/to/your/app</code></p>
            </div>

            <figure class="hero-visual" role="img" aria-label="A Notes window served by PHP, a desktop notification, and the log of the requests the runtime served.">
                <div class="mock-window">
                    <div class="mock-titlebar">
                        <span class="mock-icon"></span>
                        <span class="mock-title">Notes</span>
                        <span class="mock-controls"><i></i><i></i><i></i></span>
                    </div>
                    <div class="mock-menubar"><span>File</span><span>Edit</span><span>View</span></div>
                    <div class="mock-body">
                        <ul class="mock-list">
                            <li class="is-active"><b>Groceries</b><span>Eggs, flour, basil</span></li>
                            <li><b>Release notes</b><span>v0.1, the first window</span></li>
                            <li><b>Ideas</b><span>A tray icon for…</span></li>
                        </ul>
                        <div class="mock-note">
                            <p class="mock-note-title">Groceries</p>
                            <p>Eggs, flour, basil. Ask PHP to remember the rest.</p>
                            <span class="mock-line"></span>
                            <span class="mock-line mock-line-short"></span>
                            <span class="mock-line mock-line-shorter"></span>
                        </div>
                    </div>
                </div>
                <div class="mock-toast">
                    <span class="mock-icon"></span>
                    <span><b>Export finished</b> notes.zip is in your Downloads.</span>
                </div>
                <div class="mock-log">
                    <div class="mock-log-bar"><span>stderr</span>$ nativella run notes</div>
<pre><span class="log-tag log-muted">[nativella]</span> Data directory: ~/.local/share/com.acme.notes
<span class="log-tag log-php">[php]</span> POST php://localhost/_nativella/event 204 <b>3.1 ms</b>
<span class="log-tag log-php">[php]</span> GET php://localhost/ 200 <b>4.8 ms</b>
<span class="log-tag log-static">[static]</span> GET php://localhost/app.css 200
<span class="log-tag log-php">[php]</span> POST php://localhost/notes/42 303 <b>5.2 ms</b>
<span class="log-tag log-redirect">[redirect]</span> 303 to /notes/42, replaced by a client-side navigation.</pre>
                </div>
            </figure>
        </div>
    </section>

    <section class="unpacked" aria-labelledby="unpacked-title">
        <div class="wrap unpacked-inner">
            <h2 id="unpacked-title">What you don’t ship</h2>
            <ul class="unpacked-list">
                <li><s>nginx</s></li>
                <li><s>PHP-FPM</s></li>
                <li><s>localhost:8000</s></li>
                <li><s>a copy of Chromium</s></li>
                <li><s>Node.js</s></li>
                <li><s>Electron</s></li>
            </ul>
            <p>You ship your PHP application and a small Rust shell. The window is the webview the system already has.</p>
        </div>
    </section>

    <section class="section" aria-labelledby="why-title">
        <div class="wrap">
            <div class="section-head">
                <p class="kicker">Why it is different</p>
                <h2 id="why-title">A desktop app that remains a PHP app.</h2>
            </div>
            <div class="pillars">
                <article class="pillar">
                    <span class="pillar-number">01</span>
                    <h3>PHP runs in the application process</h3>
                    <p>Requests travel from the webview to PHP in memory, through a SAPI written in Rust. Nothing listens on <code>127.0.0.1</code>, so nothing else on the machine can talk to your app.</p>
                </article>
                <article class="pillar">
                    <span class="pillar-number">02</span>
                    <h3>The system webview</h3>
                    <p>WebKitGTK on Linux, WKWebView on macOS and WebView2 on Windows. Downloads carry neither a browser engine nor a JavaScript runtime.</p>
                </article>
                <article class="pillar">
                    <span class="pillar-number">03</span>
                    <h3>Your front controller, untouched</h3>
                    <p>PHP behaves as under PHP-FPM for <code>$_SERVER</code>, <code>$_POST</code>, cookies, sessions and <code>header()</code>. An application that runs behind nginx should run here.</p>
                </article>
                <article class="pillar">
                    <span class="pillar-number">04</span>
                    <h3>A single executable</h3>
                    <p><code>nativella build</code> packs the project and PHP into a single executable, so the machine does not need PHP. The same bundle goes into an Android APK or an iOS app.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="section section-tinted" aria-labelledby="php-title">
        <div class="wrap split">
            <div class="split-text">
                <p class="kicker">Plain PHP objects</p>
                <h2 id="php-title">Native features are PHP method calls.</h2>
                <p>Every native API is a small, typed PHP class with named arguments, enums and value objects, and it throws an exception when the system refuses. Inject them in Symfony or Laravel, or get them all from <code>Nativella::create()</code>.</p>
                <p>Native events, such as a menu click, a global shortcut or files dropped on a window, reach PHP as typed objects and the page’s JavaScript as <code>nativella:*</code> DOM events.</p>
                <p><a class="link-arrow" href="docs/lifecycle/">Lifecycle and events</a></p>
            </div>
            <div class="split-code">
                {% apply highlight('php', 'src/Import.php') %}
                    use Nativella\Dialog\FileFilter;
                    use Nativella\Nativella;

                    $native = Nativella::create();

                    $path = $native->dialog->openFile(
                        title: 'Import a note',
                        filters: [new FileFilter('Markdown', ['md'])],
                    );

                    if (null !== $path) {
                        $id = $notes->import($path);

                        $native->notification->send('Imported', basename($path));
                        $native->window->navigate('/notes/'.$id);
                    }
                {% endapply %}
            </div>
        </div>
    </section>

    <section class="section" id="how-it-works" aria-labelledby="how-title">
        <div class="wrap">
            <div class="section-head">
                <p class="kicker">How it works</p>
                <h2 id="how-title">PHP and the window share one process.</h2>
                <p>A Tauri window registers a <code>php://</code> scheme, and every request of that scheme goes to an embedded PHP instead of the network.</p>
            </div>
            <div class="diagram" tabindex="0" aria-label="Diagram, scrollable">
                {{ architecture|raw }}
            </div>
            <p class="diagram-hint" aria-hidden="true">Scroll sideways for the whole diagram →</p>
            <ol class="steps">
                <li>The webview hands the <code>php://localhost/</code> request to Rust. A file of <code>public/</code> comes straight back from disk.</li>
                <li>The other requests are queued to the PHP thread, which runs your front controller through a custom SAPI. The runtime adds the cookie jar and the redirects WebKit skips for custom schemes.</li>
                <li>PHP calls native code with <code>nativella_call()</code>, wrapped by the PHP package.</li>
                <li>Native events come back as internal requests to <code>/_nativella/event</code>, which no page can forge.</li>
                <li>They also reach the page as <code>nativella:*</code> DOM events.</li>
            </ol>
            <p class="section-more"><a class="link-arrow" href="docs/how-it-works/">How it works in detail, and what WebKit does not do</a></p>
        </div>
    </section>

    <section class="section section-tinted" id="apis" aria-labelledby="apis-title">
        <div class="wrap">
            <div class="section-head">
                <p class="kicker">Native APIs</p>
                <h2 id="apis-title">The APIs a desktop app needs.</h2>
            </div>
            <ul class="api-grid">
                {% for api in apis %}
                    <li>
                        <a class="api-card" href="docs/{{ api.slug }}/">
                            <h3>{{ api.name }}</h3>
                            <p>{{ api.description }}</p>
                            <code>{{ api.example }}</code>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    <section class="section" aria-labelledby="frameworks-title">
        <div class="wrap split split-wide-code">
            <div class="split-text">
                <p class="kicker">Bring your framework</p>
                <h2 id="frameworks-title">A menu item in Symfony, Laravel and plain PHP.</h2>
                <p>A <em>File › Export…</em> item is set when the app boots. Its click arrives as a <code>MenuItemClicked</code> event, handled by a Symfony listener, a Laravel listener, or three lines at the top of <code>index.php</code>.</p>
                <p>The Symfony bundle and the Laravel package also register the APIs in the container, point the database to the data directory and migrate it at boot.</p>
                <p><a class="link-arrow" href="docs/symfony/">Symfony</a> <a class="link-arrow" href="docs/laravel/">Laravel</a> <a class="link-arrow" href="docs/plain-php/">Plain PHP</a></p>
            </div>
            <div class="tabs">
                <div class="tab-list" role="tablist" aria-label="Framework">
                    <button type="button" role="tab" id="tab-symfony" aria-controls="panel-symfony" aria-selected="true">Symfony</button>
                    <button type="button" role="tab" id="tab-laravel" aria-controls="panel-laravel" aria-selected="false">Laravel</button>
                    <button type="button" role="tab" id="tab-vanilla" aria-controls="panel-vanilla" aria-selected="false">Plain PHP</button>
                </div>
                <div class="tab-panel" role="tabpanel" id="panel-symfony" aria-labelledby="tab-symfony">
                    {% apply highlight('php', 'src/EventListener/ExportListener.php') %}
                        namespace App\EventListener;

                        use App\Note\NoteExporter;
                        use Nativella\Dialog;
                        use Nativella\Event\MenuItemClicked;
                        use Nativella\Notification;
                        use Symfony\Component\EventDispatcher\Attribute\AsEventListener;

                        #[AsEventListener]
                        final readonly class ExportListener
                        {
                            public function __construct(
                                private Dialog $dialog,
                                private NoteExporter $exporter,
                                private Notification $notification,
                            ) {
                            }

                            public function __invoke(MenuItemClicked $event): void
                            {
                                if ('export' !== $event->id) {
                                    return;
                                }

                                $path = $this->dialog->saveFile(fileName: 'notes.zip');
                                if (null !== $path) {
                                    $this->exporter->export($path);
                                    $this->notification->send('Export finished', $path);
                                }
                            }
                        }
                    {% endapply %}
                </div>
                <div class="tab-panel" role="tabpanel" id="panel-laravel" aria-labelledby="tab-laravel" hidden>
                    {% apply highlight('php', 'app/Listeners/ExportNotes.php') %}
                        namespace App\Listeners;

                        use App\Notes\NoteExporter;
                        use Nativella\Event\MenuItemClicked;
                        use Nativella\Laravel\Facades\Dialog;
                        use Nativella\Laravel\Facades\Notification;

                        final readonly class ExportNotes
                        {
                            public function __construct(
                                private NoteExporter $exporter,
                            ) {
                            }

                            public function handle(MenuItemClicked $event): void
                            {
                                if ('export' !== $event->id) {
                                    return;
                                }

                                $path = Dialog::saveFile(fileName: 'notes.zip');
                                if (null !== $path) {
                                    $this->exporter->export($path);
                                    Notification::send('Export finished', $path);
                                }
                            }
                        }
                    {% endapply %}
                </div>
                <div class="tab-panel" role="tabpanel" id="panel-vanilla" aria-labelledby="tab-vanilla" hidden>
                    {% apply highlight('php', 'public/index.php') %}
                        use App\NoteExporter;
                        use Nativella\Event\EventFactory;
                        use Nativella\Event\MenuItemClicked;
                        use Nativella\Nativella;

                        require dirname(__DIR__).'/vendor/autoload.php';

                        $native = Nativella::create();

                        // Null unless the runtime itself sent the request.
                        if (null !== $event = EventFactory::fromGlobals()) {
                            if ($event instanceof MenuItemClicked && 'export' === $event->id) {
                                $path = $native->dialog->saveFile(fileName: 'notes.zip');
                                if (null !== $path) {
                                    (new NoteExporter($pdo))->export($path);
                                    $native->notification->send('Export finished', $path);
                                }
                            }

                            http_response_code(204);

                            return;
                        }

                        // …the pages of the application, as usual.
                    {% endapply %}
                </div>
            </div>
        </div>
    </section>

    <section class="section section-tinted" aria-labelledby="start-title">
        <div class="wrap">
            <div class="section-head">
                <p class="kicker">Getting started</p>
                <h2 id="start-title">From a PHP project to a window, in three steps.</h2>
            </div>
            <ol class="start-steps">
                <li>
                    <div class="start-text">
                        <h3>Download the runtime</h3>
                        <p>You only do this once. The executable has PHP inside. On macOS (Apple silicon), it needs nothing else. On Linux, it needs glibc 2.35 and the system webview, WebKitGTK, which desktops such as Ubuntu 24.04 and Fedora Workstation 43 already have (<a href="docs/installation/#linux-x86_64">its package</a> elsewhere).</p>
                    </div>
                    {% apply highlight('bash') %}
                        # Linux x86_64
                        sudo apt install libwebkit2gtk-4.1-0   # Fedora: dnf install webkit2gtk4.1, Arch: pacman -S webkit2gtk-4.1
                        curl -fLo nativella https://github.com/lyrixx/nativella/releases/latest/download/nativella-linux-x86_64
                        # macOS arm64
                        curl -fLo nativella https://github.com/lyrixx/nativella/releases/latest/download/nativella-macos-aarch64
                        # Both
                        chmod +x nativella && sudo mv nativella /usr/local/bin/
                    {% endapply %}
                </li>
                <li>
                    <div class="start-text">
                        <h3>Add the package</h3>
                        <p>In your project's directory, install the Symfony bundle, the Laravel package or the PHP API on its own from Packagist.</p>
                    </div>
                    {% apply highlight('bash') %}
                        # Symfony
                        composer require nativella/symfony-bundle
                        # Laravel
                        composer require nativella/laravel
                        # Plain PHP
                        composer require nativella/nativella
                    {% endapply %}
                </li>
                <li>
                    <div class="start-text">
                        <h3>Run it</h3>
                        <p>From the same directory, a window opens on your home page. When the app is ready, pack it into one executable, in <code>dist/</code>: it runs on machines without Nativella.</p>
                    </div>
                    {% apply highlight('bash') %}
                        nativella run
                        nativella build
                    {% endapply %}
                </li>
            </ol>
            <p class="section-more"><a class="link-arrow" href="docs/installation/">Installation, step by step</a></p>
        </div>
    </section>

    <section class="section" aria-labelledby="demos-title">
        <div class="wrap">
            <div class="section-head">
                <p class="kicker">Demos</p>
                <h2 id="demos-title">Three small demo applications.</h2>
                <p>They live in the repository, and run with <code>nativella run demos/&lt;name&gt;</code> after a <code>composer install</code>.</p>
            </div>
            <ul class="demo-grid">
                <li class="demo">
                    <p class="demo-stack">Symfony · Doctrine · Twig</p>
                    <h3>Notes</h3>
                    <p>Markdown notes with an application menu, a tray icon, context menus, a quick-note global shortcut, and files dropped on the window turned into notes.</p>
                    <a href="{{ site.repository }}/tree/main/demos/symfony"><code>demos/symfony</code></a>
                </li>
                <li class="demo">
                    <p class="demo-stack">Laravel · Eloquent · Blade</p>
                    <h3>Tasks</h3>
                    <p>A task list that exports through a save dialog, keeps a count in the tray and comes back to the front with a global shortcut.</p>
                    <a href="{{ site.repository }}/tree/main/demos/laravel"><code>demos/laravel</code></a>
                </li>
                <li class="demo">
                    <p class="demo-stack">Plain PHP · DBAL · no framework</p>
                    <h3>Snippets</h3>
                    <p>Text snippets copied to the clipboard in one click, deleted after a native confirmation, imported from files picked or dropped.</p>
                    <a href="{{ site.repository }}/tree/main/demos/vanilla"><code>demos/vanilla</code></a>
                </li>
            </ul>
        </div>
    </section>

    <section class="section section-tinted section-phone" aria-labelledby="phone-title">
        <div class="wrap split split-phone">
            <div class="split-text">
                <p class="kicker">Android and iOS · experimental</p>
                <h2 id="phone-title">The Notes demo on a phone.</h2>
                <p>These screenshots show the Symfony demo, unchanged, built into an APK with <code>castor mobile:android symfony</code> and running on an Android 16 emulator. It has Doctrine migrations at boot, forms and sessions, Markdown, the phone’s clipboard and a native dialog opened by PHP. A note takes the phone’s location in one method call, and the other demos vibrate and ask for a fingerprint. The CI opens it in an Android emulator and in the iOS simulator, on every change that can break it.</p>
                <p class="phone-note">iOS runs in the simulator only for now. The PHP inside is the desktop’s, intl included, built for the phone by Nativella.</p>
                <p><a class="link-arrow" href="docs/mobile/">Mobile documentation</a></p>
            </div>
            <div class="phones">
                <figure class="phone">
                    <img src="{{ asset('android/notes-note.webp') }}" width="360" height="800" loading="lazy" decoding="async" alt="The Notes demo on an Android phone: a note titled “Hello from Android”, its Markdown rendered as “PHP 8.5 runs in-process.”">
                    <figcaption>Markdown rendered by PHP</figcaption>
                </figure>
                <figure class="phone">
                    <img src="{{ asset('android/notes-copied.webp') }}" width="360" height="800" loading="lazy" decoding="async" alt="After tapping Copy, the page says “Copied as Markdown.”, and the clipboard preview of Android shows the Markdown source that PHP copied.">
                    <figcaption>Copied to the clipboard by PHP</figcaption>
                </figure>
                <figure class="phone">
                    <img src="{{ asset('android/notes-confirm.webp') }}" width="360" height="800" loading="lazy" decoding="async" alt="Tapping Delete opens a native Android dialog, “Delete the note”, with Cancel and Delete buttons.">
                    <figcaption>A native dialog opened by PHP</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <section class="section section-status" id="status" aria-labelledby="status-title">
        <div class="wrap">
            <div class="section-head">
                <p class="kicker">Status</p>
                <h2 id="status-title">What works and what does not.</h2>
                <p>Nativella started as a <a href="{{ site.repository }}/tree/850aa2df4b9f15c680b81ca07696914744565496">proof of concept</a> of PHP, Rust and Tauri in one process, to find out if a Tauri window could talk to PHP without an HTTP server. It could, and the project was built on top of it. It is not finished.</p>
            </div>
            <div class="stats">
                <div class="stat"><strong>0</strong><span>ports opened</span></div>
                <div class="stat"><strong>~5 ms</strong><span>a Symfony page with Twig and a session, kernel booted every time, in the proof of concept</span></div>
                <div class="stat"><strong>1</strong><span>executable for the whole project</span></div>
            </div>
            <div class="status-columns">
                <div class="status-card status-yes">
                    <h3>Works today</h3>
                    <ul>
                        <li>Symfony, Laravel and plain PHP, front controller untouched</li>
                        <li>Forms, sessions, cookies, redirects and downloads</li>
                        <li>Twenty-four native APIs, twenty-two native events</li>
                        <li>SQLite in the data directory, migrated at boot</li>
                        <li>A single executable carrying the project and its own PHP, which updates itself</li>
                        <li>Debian packages, on Linux</li>
                        <li>macOS apps, signed ad hoc: the three demos, on macOS 14</li>
                        <li>Android, experimentally: the three demos, in arm64 APKs</li>
                        <li>iOS, experimentally: the Symfony demo, in the simulator</li>
                    </ul>
                </div>
                <div class="status-card status-no">
                    <h3>Not yet</h3>
                    <ul>
                        <li>macOS: no notarization; Windows: never built; iOS: no device</li>
                        <li>One PHP thread: a dialog holds back every other request</li>
                        <li>No worker mode: the framework boots on every request</li>
                        <li>Installers for macOS and Windows, signing by a developer, notarization</li>
                        <li>No PHP API for photos or the microphone: pages use <code>getUserMedia()</code></li>
                        <li>No screen readers on Linux, to dodge a WebKitGTK crash</li>
                    </ul>
                </div>
            </div>
            <p class="section-more"><a class="link-arrow" href="docs/limitations/">Limitations and roadmap</a></p>
        </div>
    </section>

