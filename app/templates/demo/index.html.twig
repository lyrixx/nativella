{% extends 'base.html.twig' %}

{% block title %}native-php{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('app.css') }}">
{% endblock %}

{% block body %}
    <main>
        <header>
            <h1>native-php</h1>
            <p class="lead">A Symfony app served in-process by a Rust runtime: no HTTP server, no TCP port.</p>
        </header>

        {% for message in app.flashes('success') %}
            <p class="flash">{{ message }}</p>
        {% endfor %}

        {% if not native %}
            <p class="flash warning">Not running in the native-php runtime: the native calls are disabled.</p>
        {% endif %}

        <section class="facts">
            <dl>
                <div><dt>SAPI</dt><dd>{{ sapi }}</dd></div>
                <div><dt>PHP</dt><dd>{{ constant('PHP_VERSION') }}</dd></div>
                <div><dt>Symfony</dt><dd>{{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }}</dd></div>
                <div><dt>Request start → controller</dt><dd>{{ msToController|number_format(1) }} ms</dd></div>
                <div><dt>Visits (session cookie)</dt><dd>{{ visits }}</dd></div>
            </dl>
        </section>

        <section>
            <h2>PHP → native</h2>
            <form method="post" action="{{ path('demo_title') }}" class="inline">
                <input type="text" name="title" placeholder="New window title" required>
                <button {{ native ? '' : 'disabled' }}>Set the window title</button>
            </form>
            <div class="buttons">
                <form method="post" action="{{ path('demo_dialog') }}"><button {{ native ? '' : 'disabled' }}>Ask with a native dialog</button></form>
                <form method="post" action="{{ path('demo_pick_file') }}"><button {{ native ? '' : 'disabled' }}>Pick a file</button></form>
                <form method="post" action="{{ path('demo_notify') }}"><button {{ native ? '' : 'disabled' }}>Send a notification</button></form>
            </div>
        </section>

        <section>
            <h2>Native → PHP</h2>
            <p>Use <em>Demo › Ping PHP</em> in the menu, or focus another window and come back: the runtime sends the event to PHP, which logs it (and answers the ping with a notification). Reload to see them.</p>
            {% if events is empty %}
                <p class="muted">No event yet.</p>
            {% else %}
                <ol class="events">
                    {% for event in events %}
                        <li><code>{{ event.name }}</code> <span class="muted">{{ event.receivedAt|date('H:i:s') }}</span>{% if event.payload is not empty %} <code>{{ event.payload|json_encode }}</code>{% endif %}</li>
                    {% endfor %}
                </ol>
            {% endif %}
        </section>
    </main>
{% endblock %}
