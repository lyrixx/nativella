#!/bin/sh
# Stands in for the PHP of a static build in ext-php-rs's build script, which
# reads `php -i`: an embed-only PHP has no php binary, and the PHP of the host
# cannot describe a cross-compiled one. NATIVELLA_PHP_DIR is the buildroot of
# `castor static-php:build`, for the desktop, or of `castor
# static-php:android` or `static-php:ios`, for a phone.
set -eu
dir=${NATIVELLA_PHP_DIR:?Set NATIVELLA_PHP_DIR to a PHP build: see the castor tasks static-php:build, static-php:android and static-php:ios.}
include="$dir/include/php"
config="$include/main/php_config.h"

if [ "${1:-}" != "-i" ]; then
    echo "This stand-in only answers \`php -i\`." >&2
    exit 1
fi

api=$(sed -n 's/^#define PHP_API_VERSION \([0-9]*\).*/\1/p' "$include/main/php.h")
thread_safety=disabled
grep -q '^#define ZTS 1' "$config" && thread_safety=enabled
debug=no
grep -q '^#define ZEND_DEBUG 1' "$config" && debug=yes

printf 'PHP API => %s\nThread Safety => %s\nDebug Build => %s\n' "$api" "$thread_safety" "$debug"
