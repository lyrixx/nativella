{
    "name": "nativella/laravel",
    "description": "Runs Laravel applications as desktop applications with Nativella.",
    "type": "library",
    "keywords": ["desktop", "laravel", "native", "nativella"],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "nativella/nativella": "^0.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "Nativella\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nativella\\Laravel\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../nativella",
            "options": {
                "versions": {
                    "nativella/nativella": "0.4.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        },
        "laravel": {
            "providers": [
                "Nativella\\Laravel\\NativellaServiceProvider"
            ]
        }
    }
}
