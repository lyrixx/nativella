# tools/phpstan/project.neon, with Larastan: it understands the container,
# the facades and Eloquent, booting the package in Testbench.
includes:
    - ../../tools/phpstan/project.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - config
        - routes
        - src
        - tests
