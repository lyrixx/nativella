{
    "name": "nativella/nativella",
    "description": "The native APIs of Nativella for PHP, on the desktop and on phones: windows, menus, dialogs, notifications, clipboard, tray…",
    "type": "library",
    "keywords": [
        "desktop",
        "native",
        "nativella",
        "tauri"
    ],
    "homepage": "https://lyrixx.github.io/nativella/",
    "license": "MIT",
    "authors": [
        {
            "name": "Grégoire Pineau"
        }
    ],
    "support": {
        "docs": "https://lyrixx.github.io/nativella/docs/",
        "issues": "https://github.com/lyrixx/nativella/issues",
        "source": "https://github.com/lyrixx/nativella"
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "Nativella\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nativella\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    }
}
