{
    "name": "nativella/nativella",
    "description": "The native APIs of Nativella for PHP, on the desktop and on phones: windows, menus, dialogs, notifications, clipboard, tray…",
    "type": "library",
    "keywords": [
        "desktop",
        "native",
        "nativella",
        "tauri"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "Nativella\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nativella\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}
